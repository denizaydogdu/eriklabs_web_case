# e-bebek test ortami degiskenleri
# Bu dosyayi .env olarak kopyalayip gercek degerleri girin: cp .env.example .env

BASE_URL=https://www.e-bebek.com
# Storefront'un OCC API adresi (API uzerinden oturum acan senaryo icin)
API_URL=https://api2.e-bebek.com

# Giris bilgileri (telefon 10 hane, basinda 0 olmadan)
EBEBEK_PHONE=5xxxxxxxxx
EBEBEK_PASSWORD=

# Tarayici davranisi
HEADLESS=true
SLOW_MO=0

# Kosum videosu kaydi (varsayilan kapali). Acikken yalnizca basarisiz
# senaryolarin kaydi Allure raporuna eklenir, digerleri silinir.
VIDEO=false

# Zaman asimlari (ms)
DEFAULT_TIMEOUT=20000
NAV_TIMEOUT=45000
LOCALE=tr-TR
