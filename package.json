{
  "name": "ebebek-web-automation",
  "version": "1.0.0",
  "description": "e-bebek uctan uca web test otomasyonu (Playwright + Cucumber + Allure)",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "cucumber-js",
    "test:unit": "node --test utils/",
    "test:parallel": "cucumber-js -p parallel",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:regression": "cucumber-js --tags @regression",
    "test:negative": "cucumber-js --tags @negative",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm run report:generate && npm run report:open",
    "clean": "rimraf allure-results allure-report reports/screenshots reports/traces"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "allure",
    "e2e",
    "qa-automation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@cucumber/pretty-formatter": "^4.0.0",
    "@playwright/test": "1.61.1",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.0.9",
    "dotenv": "^16.4.7",
    "rimraf": "^6.0.1"
  }
}
